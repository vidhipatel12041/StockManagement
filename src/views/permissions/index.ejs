<%- include('../layouts/header', { title: 'Permissions' }) %>
<div class="page-actions">
  <h2><i class="bi bi-key me-2 text-primary-custom"></i>Permissions</h2>
  <a href="/permissions/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Permission</a>
</div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Name</th><th>Key</th><th>Description</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (permissions && permissions.length > 0) { %>
          <% permissions.forEach(function(permission) { %>
          <tr>
            <td class="fw-600"><%= permission.name %></td>
            <td><code class="fs-12"><%= permission.key %></code></td>
            <td class="text-muted"><%= permission.description || '—' %></td>
            <td><div class="action-btns">
              <a href="/permissions/<%= permission._id %>/edit" class="btn btn-sm btn-outline-primary btn-icon"><i class="bi bi-pencil"></i></a>
              <form method="post" action="/permissions/<%= permission._id %>/delete" class="d-inline">
                <button class="btn btn-sm btn-outline-danger btn-icon" type="submit"><i class="bi bi-trash"></i></button>
              </form>
            </div></td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr><td colspan="4"><div class="empty-state"><i class="bi bi-key"></i><p>No permissions defined.</p></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../layouts/footer') %>