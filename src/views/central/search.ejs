<%- include('../layouts/header', { title: 'Barcode Search' }) %>
<div class="search-hero">
  <h2><i class="bi bi-upc-scan me-2"></i>Barcode Search</h2>
  <p>Scan or type a barcode to check product availability across all branches</p>
  <form method="get" action="/central/search">
    <div class="input-group input-group-lg">
      <input type="text" name="barcode" class="form-control" placeholder="Scan or type barcode..." value="<%= barcode || '' %>" autofocus>
      <button class="btn btn-warning px-4" type="submit"><i class="bi bi-search"></i> Search</button>
    </div>
  </form>
</div>
<% if (error) { %>
  <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill me-1"></i> <%= error %></div>
<% } %>
<% if (result) { %>
<div class="row g-4">
  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><h5 class="card-title"><i class="bi bi-box-seam me-2 text-primary-custom"></i>Product Info</h5></div>
      <div class="card-body">
        <h4 class="fw-700 mb-3"><%= result.product.name %></h4>
        <table class="table table-sm mb-0">
          <tr><th class="text-muted fw-600 border-0 ps-0">SKU</th><td class="border-0"><code><%= result.product.sku %></code></td></tr>
          <tr><th class="text-muted fw-600 ps-0">Barcode</th><td><code><%= result.product.barcode %></code></td></tr>
          <tr><th class="text-muted fw-600 ps-0">MRP</th><td><strong><%= result.product.mrp %></strong></td></tr>
          <tr><th class="text-muted fw-600 ps-0">Brand</th><td><%= result.product.brand ? result.product.brand.name : '—' %></td></tr>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-8">
    <div class="card">
      <div class="card-header"><h5 class="card-title"><i class="bi bi-geo-alt me-2 text-primary-custom"></i>Branch Availability</h5></div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>Branch</th><th>Quantity</th><th>Status</th></tr></thead>
            <tbody>
              <% if (result.availability && result.availability.length > 0) { %>
              <% result.availability.forEach(function(stock) { %>
              <tr>
                <td><i class="bi bi-building me-1 text-muted"></i><%= stock.branch ? stock.branch.name : '—' %></td>
                <td><strong class="<%= stock.quantity > 0 ? 'text-success' : 'text-danger' %>" style="font-size:18px"><%= stock.quantity %></strong></td>
                <td><span class="status-badge status-<%= stock.status %>"><%= stock.status %></span></td>
              </tr>
              <% }) %>
              <% } else { %>
              <tr><td colspan="3"><div class="empty-state py-4"><i class="bi bi-geo-alt"></i><p>No stock records found.</p></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>
<%- include('../layouts/footer') %>