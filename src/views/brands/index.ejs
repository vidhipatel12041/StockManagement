<%- include('../layouts/header', { title: 'Brands' }) %>
<div class="page-actions">
  <h2><i class="bi bi-award me-2 text-primary-custom"></i>Brands</h2>
  <a href="/brands/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Brand</a>
</div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Name</th><th>Description</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (brands && brands.length > 0) { %>
          <% brands.forEach(function(brand) { %>
          <tr>
            <td class="fw-600"><%= brand.name %></td>
            <td class="text-muted"><%= brand.description || '—' %></td>
            <td><span class="status-badge status-<%= brand.status %>"><%= brand.status %></span></td>
            <td><div class="action-btns">
              <a href="/brands/<%= brand._id %>/edit" class="btn btn-sm btn-outline-primary btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
              <form method="post" action="/brands/<%= brand._id %>/delete" class="d-inline">
                <button class="btn btn-sm btn-outline-danger btn-icon" type="submit" title="Delete"><i class="bi bi-trash"></i></button>
              </form>
            </div></td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr><td colspan="4"><div class="empty-state"><i class="bi bi-award"></i><p>No brands yet.</p><a href="/brands/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New Brand</a></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../layouts/footer') %>