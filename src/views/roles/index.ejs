<%- include('../layouts/header', { title: 'Roles' }) %>
<div class="page-actions">
  <h2><i class="bi bi-shield-check me-2 text-primary-custom"></i>Roles</h2>
  <a href="/roles/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Role</a>
</div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Name</th><th>Key</th><th>Permissions</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (roles && roles.length > 0) { %>
          <% roles.forEach(function(role) { %>
          <tr>
            <td class="fw-600"><i class="bi bi-shield me-1 text-primary-custom"></i><%= role.name %></td>
            <td><code class="fs-12"><%= role.key %></code></td>
            <td><% role.permissions.forEach(function(p) { %><span class="badge bg-secondary me-1 fs-12"><%= p.name %></span><% }); %></td>
            <td><div class="action-btns">
              <a href="/roles/<%= role._id %>/edit" class="btn btn-sm btn-outline-primary btn-icon"><i class="bi bi-pencil"></i></a>
              <form method="post" action="/roles/<%= role._id %>/delete" class="d-inline">
                <button class="btn btn-sm btn-outline-danger btn-icon" type="submit"><i class="bi bi-trash"></i></button>
              </form>
            </div></td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr><td colspan="4"><div class="empty-state"><i class="bi bi-shield-check"></i><p>No roles defined.</p></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../layouts/footer') %>