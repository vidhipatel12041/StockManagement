<%- include('../layouts/header', { title: 'Create Role' }) %>
<div class="page-actions mb-0">
  <h2><i class="bi bi-shield-plus me-2 text-primary-custom"></i>Create Role</h2>
  <a href="/roles" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="card mt-4">
  <div class="card-header"><h5 class="card-title">Role Details</h5></div>
  <div class="card-body">
    <% if (error) { %><div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div><% } %>
    <form method="post" action="/roles/create">
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Role Name <span class="text-danger">*</span></label><input name="name" class="form-control" value="<%= values.name || '' %>" placeholder="e.g. Branch Manager" required></div>
        <div class="col-md-6 mb-3"><label class="form-label">Key <span class="text-danger">*</span></label><input name="key" class="form-control" value="<%= values.key || '' %>" placeholder="e.g. BRANCHMANAGER" required></div>
      </div>
      <div class="mb-3">
        <label class="form-label">Permissions</label>
        <select name="permissions" class="form-select" multiple style="min-height:120px">
          <% permissions.forEach(function(permission) { %><option value="<%= permission._id %>" <%= values.permissions && values.permissions.includes(String(permission._id)) ? 'selected' : '' %>><%= permission.name %></option><% }); %>
        </select>
        <small class="text-muted">Hold Ctrl (or Cmd on Mac) to select multiple permissions</small>
      </div>
      <div class="form-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Role</button><a href="/roles" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
  </div>
</div>
<%- include('../layouts/footer') %>