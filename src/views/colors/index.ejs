<%- include('../layouts/header', { title: 'Colors' }) %>
<div class="page-actions">
  <h2><i class="bi bi-palette me-2 text-primary-custom"></i>Colors</h2>
  <a href="/colors/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Color</a>
</div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Name</th><th>Hex Code</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (colors && colors.length > 0) { %>
          <% colors.forEach(function(color) { %>
          <tr>
            <td class="fw-600"><% if (color.hexCode) { %><span class="color-swatch" style="background:<%= color.hexCode %>"></span><% } %><%= color.name %></td>
            <td><% if (color.hexCode) { %><code class="fs-12"><%= color.hexCode %></code><% } else { %>—<% } %></td>
            <td><span class="status-badge status-<%= color.status %>"><%= color.status %></span></td>
            <td><div class="action-btns">
              <a href="/colors/<%= color._id %>/edit" class="btn btn-sm btn-outline-primary btn-icon"><i class="bi bi-pencil"></i></a>
              <form method="post" action="/colors/<%= color._id %>/delete" class="d-inline">
                <button class="btn btn-sm btn-outline-danger btn-icon" type="submit"><i class="bi bi-trash"></i></button>
              </form>
            </div></td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr><td colspan="4"><div class="empty-state"><i class="bi bi-palette"></i><p>No colors yet.</p><a href="/colors/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New Color</a></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../layouts/footer') %>