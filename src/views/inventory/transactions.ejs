<%- include('../layouts/header', { title: 'Stock Transactions' }) %>
<div class="page-actions">
  <h2><i class="bi bi-list-ul me-2 text-primary-custom"></i>Stock Transactions</h2>
  <a href="/inventory/transactions/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Transaction</a>
</div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Date</th><th>Branch</th><th>Product</th><th>Type</th><th>Quantity</th><th>Reference</th><th>Created By</th><th>Notes</th></tr></thead>
        <tbody>
          <% if (transactions && transactions.length > 0) { %>
          <% transactions.forEach(function(tx) { %>
          <tr>
            <td class="text-muted fs-12"><%= tx.createdAt ? tx.createdAt.toLocaleString() : '—' %></td>
            <td><%= tx.branch ? tx.branch.name : '—' %></td>
            <td class="fw-600"><%= tx.product ? tx.product.name : '—' %></td>
            <td><span class="status-badge type-<%= tx.type %>"><%= tx.type === 'in' ? '📥 In' : '📤 Out' %></span></td>
            <td><strong><%= tx.quantity %></strong></td>
            <td><%= tx.reference || '—' %></td>
            <td><%= tx.createdBy ? tx.createdBy.name : '—' %></td>
            <td class="text-muted"><%= tx.notes || '—' %></td>
          </tr>
          <% }) %>
          <% } else { %>
          <tr><td colspan="8"><div class="empty-state"><i class="bi bi-list-ul"></i><p>No transactions recorded yet.</p></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../layouts/footer') %>