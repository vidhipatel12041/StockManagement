<%- include('../layouts/header', { title: 'Edit Product' }) %>
<div class="page-actions mb-0">
  <h2><i class="bi bi-box-seam me-2 text-primary-custom"></i>Edit Product</h2>
  <a href="/products" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="card mt-4">
  <div class="card-header"><h5 class="card-title">Product Details</h5></div>
  <div class="card-body">
    <% if (error) { %><div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div><% } %>
    <form method="post" action="/products/<%= values._id %>/edit">
      <div class="form-section-title">Basic Info</div>
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Product Name <span class="text-danger">*</span></label><input name="name" class="form-control" value="<%= values.name || '' %>" required></div>
        <div class="col-md-3 mb-3"><label class="form-label">SKU <span class="text-danger">*</span></label><input name="sku" class="form-control" value="<%= values.sku || '' %>" required></div>
        <div class="col-md-3 mb-3"><label class="form-label">Barcode <span class="text-danger">*</span></label><input name="barcode" class="form-control" value="<%= values.barcode || '' %>" required></div>
      </div>
      <div class="form-section-title">Classification</div>
      <div class="row">
        <div class="col-md-3 mb-3"><label class="form-label">Brand</label><select name="brand" class="form-select" required><option value="">Select Brand</option><% brands.forEach(function(brand) { %><option value="<%= brand._id %>" <%= values.brand && values.brand.toString() === brand._id.toString() ? 'selected' : '' %>><%= brand.name %></option><% }); %></select></div>
        <div class="col-md-3 mb-3"><label class="form-label">Category</label><select name="category" class="form-select" required><option value="">Select Category</option><% categories.forEach(function(category) { %><option value="<%= category._id %>" <%= values.category && values.category.toString() === category._id.toString() ? 'selected' : '' %>><%= category.name %></option><% }); %></select></div>
        <div class="col-md-3 mb-3"><label class="form-label">Color</label><select name="color" class="form-select" required><option value="">Select Color</option><% colors.forEach(function(color) { %><option value="<%= color._id %>" <%= values.color && values.color.toString() === color._id.toString() ? 'selected' : '' %>><%= color.name %></option><% }); %></select></div>
        <div class="col-md-3 mb-3"><label class="form-label">Size</label><select name="size" class="form-select" required><option value="">Select Size</option><% sizes.forEach(function(size) { %><option value="<%= size._id %>" <%= values.size && values.size.toString() === size._id.toString() ? 'selected' : '' %>><%= size.name %></option><% }); %></select></div>
      </div>
      <div class="form-section-title">Pricing</div>
      <div class="row">
        <div class="col-md-4 mb-3"><label class="form-label">MRP ()</label><input name="mrp" type="number" step="0.01" class="form-control" value="<%= values.mrp || '' %>"></div>
        <div class="col-md-4 mb-3"><label class="form-label">Purchase Price ()</label><input name="purchasePrice" type="number" step="0.01" class="form-control" value="<%= values.purchasePrice || '' %>"></div>
        <div class="col-md-4 mb-3"><label class="form-label">Selling Price ()</label><input name="sellingPrice" type="number" step="0.01" class="form-control" value="<%= values.sellingPrice || '' %>"></div>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3"><label class="form-label">GST %</label><input name="gst" type="number" step="0.01" class="form-control" value="<%= values.gst || '' %>"></div>
        <div class="col-md-4 mb-3"><label class="form-label">HSN Code</label><input name="hsn" class="form-control" value="<%= values.hsn || '' %>"></div>
        <div class="col-md-4 mb-3"><label class="form-label">Status</label><select name="status" class="form-select" required><option value="active" <%= values.status === 'active' ? 'selected' : '' %>>Active</option><option value="inactive" <%= values.status === 'inactive' ? 'selected' : '' %>>Inactive</option></select></div>
      </div>
      <div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="form-control"><%= values.description || '' %></textarea></div>
      <div class="form-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button><a href="/products" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
  </div>
</div>
<%- include('../layouts/footer') %>