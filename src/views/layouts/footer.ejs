    </main><!-- end content-area / auth-wrapper -->
  <% if (locals.user) { %>
  </div><!-- end main-wrapper -->
  <% } %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <% if (locals.user) { %>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const globalSocket = io({ auth: { userId: '<%= locals.user.id || locals.user._id %>' } });
    globalSocket.on('notification', (data) => {
      if (data.type === 'newNotification') {
        const dot = document.getElementById('notif-badge');
        if (dot) dot.classList.remove('d-none');
      }
    });
    // Sidebar toggle
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('sidebar');
    if (sidebarToggle && sidebar) {
      sidebarToggle.addEventListener('click', () => {
        sidebar.classList.toggle('sidebar-open');
        document.querySelector('.main-wrapper')?.classList.toggle('sidebar-open');
      });
    }
    // Confirm deletes
    document.querySelectorAll('form[action*="/delete"]').forEach(form => {
      form.addEventListener('submit', e => {
        if (!confirm('Are you sure you want to delete this item?')) e.preventDefault();
      });
    });
  </script>
  <% } %>
</body>
</html>