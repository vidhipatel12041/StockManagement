<%- include('../layouts/header', { title: 'Create User' }) %>
<div class="page-actions mb-0">
  <h2><i class="bi bi-person-plus me-2 text-primary-custom"></i>Create User</h2>
  <a href="/users" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="card mt-4">
  <div class="card-header"><h5 class="card-title">User Details</h5></div>
  <div class="card-body">
    <% if (error) { %><div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div><% } %>
    <form method="post" action="/users/create">
      <div class="mb-3"><label class="form-label">Full Name <span class="text-danger">*</span></label><input name="name" class="form-control" value="<%= values.name || '' %>" placeholder="Full name" required></div>
      <div class="mb-3"><label class="form-label">Email Address <span class="text-danger">*</span></label><input name="email" type="email" class="form-control" value="<%= values.email || '' %>" placeholder="user@company.com" required></div>
      <div class="mb-3"><label class="form-label">Password <span class="text-danger">*</span></label><input name="password" type="password" class="form-control" placeholder="Minimum 6 characters" required></div>
      <div class="mb-3">
        <label class="form-label">Role</label>
        <select name="role" class="form-select">
          <option value="">Staff (default)</option>
          <% roles.forEach(function(role) { %><option value="<%= role._id %>" <%= values.role === String(role._id) ? 'selected' : '' %>><%= role.name %></option><% }); %>
        </select>
      </div>
      <div class="form-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-person-check"></i> Create User</button><a href="/users" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
  </div>
</div>
<%- include('../layouts/footer') %>