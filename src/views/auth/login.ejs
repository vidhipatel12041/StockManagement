<%- include('../layouts/header', { title: 'Login' }) %>
<div class="auth-card">
  <div class="auth-logo">
    <i class="bi bi-boxes"></i>
    <h2>StockFlow</h2>
    <p>Enterprise Inventory Management</p>
  </div>
  <% if (error) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
  <% } %>
  <form method="post" action="/login">
    <div class="mb-4">
      <label class="form-label">Email Address</label>
      <div class="input-icon-wrap">
        <i class="bi bi-envelope input-icon"></i>
        <input type="email" name="email" class="form-control form-control-lg ps-5" placeholder="admin@example.com" required>
      </div>
    </div>
    <div class="mb-4">
      <label class="form-label">Password</label>
      <div class="input-icon-wrap">
        <i class="bi bi-lock input-icon"></i>
        <input type="password" name="password" class="form-control form-control-lg ps-5" placeholder="••••••••" required>
      </div>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100 mt-1">
      <i class="bi bi-box-arrow-in-right"></i> Sign In
    </button>
  </form>
  <p class="auth-footer-text">Don't have an account? <a href="/register">Register here</a></p>
</div>
<%- include('../layouts/footer') %>