<%- include('../layouts/header', { title: 'Edit Branch' }) %>
<div class="page-actions mb-0">
  <h2><i class="bi bi-building me-2 text-primary-custom"></i>Edit Branch</h2>
  <a href="/branches" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="card mt-4">
  <div class="card-header"><h5 class="card-title">Branch Information</h5></div>
  <div class="card-body">
    <% if (error) { %><div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div><% } %>
    <form method="post" action="/branches/<%= values._id %>/edit">
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Branch Code <span class="text-danger">*</span></label>
          <input name="code" class="form-control" value="<%= values.code || '' %>" required>
        </div>
        <div class="col-md-8 mb-3">
          <label class="form-label">Branch Name <span class="text-danger">*</span></label>
          <input name="name" class="form-control" value="<%= values.name || '' %>" required>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Address</label>
        <textarea name="address" class="form-control"><%= values.address || '' %></textarea>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Phone</label>
          <input name="phone" class="form-control" value="<%= values.phone || '' %>">
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Email</label>
          <input name="email" type="email" class="form-control" value="<%= values.email || '' %>">
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Manager</label>
          <input name="manager" class="form-control" value="<%= values.manager || '' %>">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select" required>
          <option value="active" <%= values.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= values.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
        <a href="/branches" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../layouts/footer') %>